@using DashboardData.Models
@using DashboardData.Services
@page "/dashboard"
@rendermode InteractiveServer
@attribute [StreamRendering]
@inject ISensorService SensorService
@inject NavigationManager NavManager



<!-- Dans MyDashboard.razor -->
<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <!-- On passe les paramètres comme de simples attributs HTML -->
        <KpiCard Title="Total Sondes" Value="@TotalSondes.ToString()"
                 BackgroundColorClass="bg-primary" IconClass="bi-box-seam" />
    </div>
    <div class="col-md-4 mb-3">
        <KpiCard Title="Moyenne Globale" Value="@($"{Moyenne:F1} °C")"
                 BackgroundColorClass="bg-success" IconClass="bi-bullseye" />
    </div>
    <div class="col-md-4 mb-3">
        <KpiCard Title="Alerte Max" Value="@($"{Max:F1} °C")"
                 BackgroundColorClass="bg-danger" IconClass="bi-exclamation-triangle-fill" />
    </div>
</div>

@if(_isLoading) {
    <p><em>Chargement des données...</em></p>
}
else {
    <button class="btn btn-secondary " @onclick="LoadAll"><i class="bi bi-arrow-clockwise"></i> All Sensors</button>
    <button class="btn btn-warning " @onclick="LoadCritical"><i class="bi bi-exclamation-triangle"></i> Alertes (> 30.0)</button>
    <a href="/edit-sensor" class="btn btn-success "> <i class="bi bi-plus"></i> New Sensor</a>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Actions</th>
                <th>Sensor</th>
                <th>Location</th>
                <th>Current Value</th>
            </tr>
        </thead>
          <tbody>
            @foreach (var sensor in Sensors)
            {
                <tr>
                    <td>
                        <a href="/edit-sensor/@sensor.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSensor(sensor.Id)"><i class="bi bi-trash"></i></button>
                    </td>
                    <td>@sensor.Name</td>
                    <td>@(sensor.Location?.Name ?? "Undefined")</td>
                    <td>@sensor.Value</td>
                    <td>
    <a href="/edit-sensor/@sensor.Id" class="btn btn-sm btn-outline-primary">Éditer</a>
</td>
                </tr>
            }
        </tbody>
        <a href="/edit-sensor" class="btn btn-success mb-3">+ Nouveau Capteur</a>
</table>
}

@code {

    private bool IsSystemOK = true;
    private List<SensorData> _sensors = new List<SensorData>();
    <SensorTable Sensors="Sensors" />
    private bool _isLoading = true;
        Task<int> GetTotalCountAsync();
        Task<double> GetAverageValueAsync();
        Task<double> GetMaxValueAsync();

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private void AddNewSensor(MouseEventArgs args)
    {
        NavManager.NavigateTo("/add-sensor");
    }
      private async Task LoadAll()
    {
        Sensors = await SensorService.GetSensorsAsync();
    }

    private async Task LoadCritical()
    {
        Sensors = await SensorService.GetCriticalSensorsAsync(30.0);
    }
    private async Task LoadAll()
    {
        Sensors = await SensorService.GetSensorsAsync();
        TotalSensors = await SensorService.GetTotalCountAsync();
        Average = await SensorService.GetAverageValueAsync();
        MaxValue = await SensorService.GetMaxValueAsync();
    }

    private async Task LoadCritical()
    {
        Sensors = await SensorService.GetCriticalSensorsAsync(30.0);
    }

    private async Task DeleteSensor(int id)
    {
        if (await SensorService.GetSensorByIdAsync(id) != null)
        {
            await SensorService.DeleteSensorAsync(id);
            await LoadAll();
        }
    }
}